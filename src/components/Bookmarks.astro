<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import { STORAGE_KEY, createSlug, normalizeUrl, parseBookmarks } from './bookmarks.js';

  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');
  const readStorage = () => {
    try {
      return localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  };
  const writeStorage = (value) => {
    try {
      localStorage.setItem(STORAGE_KEY, value);
    } catch {
      // The list remains usable for this page even when storage is unavailable.
    }
  };
  let bookmarks = parseBookmarks(readStorage());

  const save = () => writeStorage(JSON.stringify(bookmarks));

  const render = () => {
    if (!list || !emptyState || !listHeader) return;
    list.replaceChildren();
    emptyState.hidden = bookmarks.length > 0;
    listHeader.hidden = bookmarks.length === 0;

    bookmarks.forEach((bookmark) => {
      const row = document.createElement('li');
      row.className = 'bookmark';
      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noreferrer';
      link.textContent = bookmark.url;
      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';
      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy slug';
      copy.addEventListener('click', async () => {
        await navigator.clipboard.writeText(bookmark.slug);
        copy.textContent = 'Copied';
        window.setTimeout(() => { copy.textContent = 'Copy slug'; }, 1200);
      });
      row.append(link, separator, slug, copy);
      list.append(row);
    });
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const url = normalizeUrl(input?.value);
    if (!url) {
      input?.setCustomValidity('Enter a valid http or https URL.');
      input?.reportValidity();
      return;
    }

    input?.setCustomValidity('');
    let slug = createSlug(Date.now());
    while (bookmarks.some((bookmark) => bookmark.slug === slug)) {
      slug = createSlug(Date.now() + Math.floor(Math.random() * 100000));
    }
    bookmarks = [...bookmarks, { url, slug }];
    save();
    render();
    if (input) {
      input.value = '';
      input.focus();
    }
  });

  clearAll?.addEventListener('click', () => {
    if (!bookmarks.length || !window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      // The in-memory list is still cleared when storage is unavailable.
    }
    render();
  });

  render();
</script>

<style>
  .bookmark .separator { color: var(--muted); }
  .bookmark .url { text-decoration-thickness: 0.08em; text-underline-offset: 0.18em; }
</style>
